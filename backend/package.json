{
  "name": "tattoo-admin-backend",
  "version": "1.0.0",
  "description": "Production-ready admin panel backend for tattoo artist booking system",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "start": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "node --test src/**/*.test.cjs",
    "seed:admin": "node src/utils/seedAdmin.js",
    "db:indexes": "node scripts/indexes.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "dayjs": "^1.11.20",
    "dotenv": "^16.6.1",
    "express-validator": "^7.3.2",
    "hono": "^4.13.17",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
