# Shared rules apply to the root and every nested folder.
# Environment values stay local. Only sanitized example templates may be tracked.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
.token-store.json
.token-store.json.*

# Dependencies, builds, caches, and test output
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
.cache/
.eslintcache
*.tsbuildinfo
.taste-skill/

# Runtime logs and local process output
logs/
*.log
*.err
*.out
*.pid
*.pid.lock
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
